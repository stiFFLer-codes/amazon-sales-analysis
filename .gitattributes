# the dataset is committed with CRLF; stop git rewriting line endings on it
*.csv -text

# report.html is generated by analyze.py and is ~700 KB of base64-embedded charts.
# Without this it counts as 97% of the repository and GitHub labels a Python
# project as HTML. linguist-generated also collapses it in diffs, which nobody
# wants to read.
report.html linguist-generated=true
